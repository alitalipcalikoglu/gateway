# --- Listener ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind another proxy/CDN that sets X-Forwarded-For (rate limits key on the client IP).
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy or CDN terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Sent with every response when TLS is on; 0 disables. Default 1 year when TLS_CERT_PATH is set.
HSTS_MAX_AGE=
SERVER_NAME=atc-gateway

# --- Routing ---
ROUTES_FILE=./routes.json

# --- Defaults (routes may override rateLimit, bodyLimit, timeoutMs) ---
RATE_LIMIT_MAX=300
BODY_LIMIT=1048576
UPSTREAM_TIMEOUT_MS=30000
UPSTREAM_CONNECT_TIMEOUT_MS=5000
UPSTREAM_COOLDOWN_MS=10000

# --- /metrics bearer token (>= 32 chars). Empty disables the endpoint. Generate: openssl rand -hex 32
METRICS_TOKEN=

# --- Service keys referenced by routes.json "injectApiKey" (one key per service, dedicated to the gateway)
AUTH_API_KEY=REPLACE_WITH_THE_GATEWAY_KEY_FROM_AUTH_API_KEYS
MEDIA_API_KEY=REPLACE_WITH_THE_GATEWAY_KEY_FROM_MEDIA_API_KEYS
NOTIFY_API_KEY=REPLACE_WITH_THE_GATEWAY_KEY_FROM_NOTIFY_API_KEYS
